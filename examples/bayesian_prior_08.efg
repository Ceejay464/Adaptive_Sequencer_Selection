EFG 2 R "Harsanyi: hidden cost and simultaneous entry" { "Firm 1" "Firm 2" }
""

c "" 1 "Nature" { "Low cost" 4/5 "High cost" 1/5 } 0
p "" 1 1 "Firm 1" { "Enter" "Out" } 0
p "" 2 1 "Firm 2: low" { "Enter" "Out" } 0
t "" 1 "Firm 2: low: 0,0" { 1, 1 }
t "" 2 "Firm 2: low: 0,1" { 3, 0 }
p "" 2 1 "Firm 2: low" { "Enter" "Out" } 0
t "" 3 "Firm 2: low: 1,0" { 0, 3 }
t "" 4 "Firm 2: low: 1,1" { 0, 0 }
p "" 1 1 "Firm 1" { "Enter" "Out" } 0
p "" 2 2 "Firm 2: high" { "Enter" "Out" } 0
t "" 5 "Firm 2: high: 0,0" { 1, -1 }
t "" 6 "Firm 2: high: 0,1" { 3, 0 }
p "" 2 2 "Firm 2: high" { "Enter" "Out" } 0
t "" 7 "Firm 2: high: 1,0" { 0, 1 }
t "" 8 "Firm 2: high: 1,1" { 0, 0 }
